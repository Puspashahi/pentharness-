{
  "schemaVersion": 1,
  "name": "pentharness-local-benchmark",
  "safety": "local-only; binds to loopback; no external requests",
  "scenarios": [
    {
      "id": "idor-cross-user",
      "class": "authz",
      "status": "executable",
      "expectation": "candidate",
      "route": "/api/orders/2"
    },
    {
      "id": "reflected-xss",
      "class": "xss",
      "status": "executable",
      "expectation": "candidate",
      "route": "/search"
    },
    {
      "id": "secure-owner-control",
      "class": "authz",
      "status": "executable",
      "expectation": "no-candidate",
      "route": "/api/secure-orders/1"
    },
    { "id": "sqli", "class": "injection", "status": "executable", "expectation": "candidate", "route": "/api/search" },
    { "id": "ssrf", "class": "ssrf", "status": "executable", "expectation": "candidate", "route": "/api/fetch" },
    { "id": "race-condition", "class": "race", "status": "executable", "expectation": "candidate", "route": "/api/race" },
    { "id": "graphql-authz", "class": "authz", "status": "executable", "expectation": "candidate", "route": "/graphql" },
    { "id": "oauth", "class": "oauth", "status": "executable", "expectation": "candidate", "route": "/oauth/authorize" },
    { "id": "websocket-authz", "class": "authz", "status": "executable", "expectation": "candidate", "route": "/ws/orders" },
    { "id": "mcp-tool-authz", "class": "ai", "status": "executable", "expectation": "candidate", "route": "/mcp/tools/call" }
  ]
}
